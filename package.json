{
  "name": "hrms-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise HRMS Platform - 37 Modules",
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm -w backend run dev",
    "dev:frontend": "npm -w frontend run dev",
    "build": "npm -w shared run build && npm -w backend run build && npm -w frontend run build",
    "lint": "npm -w backend run lint && npm -w frontend run lint",
    "test": "npm -w backend run test && npm -w frontend run test",
    "db:migrate": "npm -w backend run db:migrate",
    "db:seed": "npm -w backend run db:seed",
    "db:studio": "npm -w backend run db:studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.1"
  }
}
